# CalcMaster Pro - Git Ignore

# Environment Variables & Secrets
.env
.env.local
.env.*.local
*.env
backend/.env
frontend/.env

# Python & Django
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
ENV/
env.bak/
venv.bak/
db.sqlite3
db.sqlite3-journal
*.log

# Media uploads (keep sample QR, ignore user submissions)
backend/media/screenshots/*
!backend/media/screenshots/.gitkeep

# Node & Frontend
node_modules/
dist/
dist-ssr/
*.local
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# IDE & OS
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db















